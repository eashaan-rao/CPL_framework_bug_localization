\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Source selection heuristic evaluation. Two heuristics tested: \emph  {most-bugs} (source with largest bug corpus) and \emph  {domain-gap} (source with lowest embedding-space domain gap). ``\% oracle'' = mean CP-transfer MRR of selected source as a fraction of oracle CP-transfer MRR. No heuristic reliably ranks sources ($\tau < 0.2$ in all cases), yet oracle recovery remains high (74--93\%) for all strategies.}}{18}{table.11}\protected@file@percent }
\newlabel{tab:source_selection}{{11}{18}{Source selection heuristic evaluation. Two heuristics tested: \emph {most-bugs} (source with largest bug corpus) and \emph {domain-gap} (source with lowest embedding-space domain gap). ``\% oracle'' = mean CP-transfer MRR of selected source as a fraction of oracle CP-transfer MRR. No heuristic reliably ranks sources ($\tau < 0.2$ in all cases), yet oracle recovery remains high (74--93\%) for all strategies}{table.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Source selection ranking quality (most-bugs heuristic) for BLAZE (left), COOBA (center), and TRANP-CNN (right). Bubble size proportional to target bug count; color indicates oracle rank of the selected source. Table~\ref {tab:source_selection} reports results for both heuristics.}}{18}{figure.8}\protected@file@percent }
\newlabel{fig:ss_quality}{{8}{18}{Source selection ranking quality (most-bugs heuristic) for BLAZE (left), COOBA (center), and TRANP-CNN (right). Bubble size proportional to target bug count; color indicates oracle rank of the selected source. Table~\ref {tab:source_selection} reports results for both heuristics}{figure.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Illustrative Cases}{18}{subsection.4.4}\protected@file@percent }
\newlabel{sec:cases}{{4.4}{18}{Illustrative Cases}{subsection.4.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Case 1: BLAZE cold-start viability (lightning-ai\,$\to $\,xarray).}{18}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Case 2: Architecture divergence on the same pair (wagtail\,$\to $\,docker/compose).}{18}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Case 3: TRANP-CNN CP-transfer exceeds full within-project training (jupyterlab\,$\to $\,scikit-learn).}{19}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Discussion}{19}{section.5}\protected@file@percent }
\newlabel{sec:discussion}{{5}{19}{Discussion}{section.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Practical Implications}{19}{subsection.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. For BLAZE, CPL showed consistent benefit with low loss exposure in this corpus.}{19}{section*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Target codebase size moderates benefit; validate empirically for large targets.}{19}{section*.25}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Choose sources by domain, not by ranking heuristics or within-project quality.}{19}{section*.26}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. With 20\% target labels, TRANP-CNN reaches full within-project training performance.}{19}{section*.27}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. Empirical holdout validation is the safest guard against negative transfer.}{19}{section*.28}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6. CP-transfer's benefit has a compute cost that WP-small does not.}{19}{section*.29}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Architectural Interpretation of CPL Profiles}{19}{subsection.5.2}\protected@file@percent }
\newlabel{sec:architecture}{{5.2}{19}{Architectural Interpretation of CPL Profiles}{subsection.5.2}{}}
