\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces CPL gain by domain alignment (within-domain = same application category; cross-domain = different category). $\Delta $MRR = mean CP-transfer $-$ WP-small MRR. Win Rate uses the $\pm 0.01$ MRR neutral band, a different (stricter) threshold than Table~\ref {tab:wilcoxon}'s zero-cutoff Win \% (see that table's caption). TRANP-CNN shows the steepest domain sensitivity (24.5 percentage-point win-rate drop); COOBA shows essentially no domain effect ($-$2pp, cross-domain slightly higher); BLAZE shows only a marginal domain effect (2.1pp drop) and remains strong cross-domain (87.9\% win rate).}}{16}{table.9}\protected@file@percent }
\newlabel{tab:crossdomain}{{9}{16}{CPL gain by domain alignment (within-domain = same application category; cross-domain = different category). $\Delta $MRR = mean CP-transfer $-$ WP-small MRR. Win Rate uses the $\pm 0.01$ MRR neutral band, a different (stricter) threshold than Table~\ref {tab:wilcoxon}'s zero-cutoff Win \% (see that table's caption). TRANP-CNN shows the steepest domain sensitivity (24.5 percentage-point win-rate drop); COOBA shows essentially no domain effect ($-$2pp, cross-domain slightly higher); BLAZE shows only a marginal domain effect (2.1pp drop) and remains strong cross-domain (87.9\% win rate)}{table.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces CPL gain distributions (CP-transfer $-$ WP-small MRR) for within-domain (DS$\times $DS) versus cross-domain pairs across all three models; see Table~\ref {tab:crossdomain} for the corresponding win rates.}}{16}{figure.6}\protected@file@percent }
\newlabel{fig:cross_domain}{{6}{16}{CPL gain distributions (CP-transfer $-$ WP-small MRR) for within-domain (DS$\times $DS) versus cross-domain pairs across all three models; see Table~\ref {tab:crossdomain} for the corresponding win rates}{figure.6}{}}
