    "def verify_and_clean_dataset(metadata_path, bugs_path, clone_dir):\n",
    "    '''\n",
    "    Verifies the existence of pre_fix_commit_sha for each bug report,\n",
    "    cleans the bug report data, and updates the project metadata accordingly.\n",
    "    '''\n",
    "    print(\"--- Final Dataset Verification and Cleaning\")\n",
    "    \n",
    "    # 1. Load Dataframes\n",
    "    try:\n",
    "        project_meta_df = pd.read_parquet(metadata_path)\n",
    "        bug_reports_df = pd.read_parquet(bugs_path)\n",
    "    except FileNotFoundError as e:\n",
    "        print(f\"Error: Could not find input file. {e}\")\n",
    "        return \n",
    "    \n",
    "    # 2. Initial Reporting \n",
    "    print(\"\\n -- Initial MetaData Summary ---\")\n",
    "    print(f\"(a) Total repositories in metadata: {len(project_meta_df)}\")\n",
    "    print(f\"(a) Sum of 'total_unique_bug_reports' before cleaning: {project_meta_df['total_unique_bug_reports'].sum()}\")\n",
    "\n",
    "    valid_bug_indices = []\n",
    "\n",
    "    # 3. Verification loop\n",
    "    print(\"\\n -- Verifying Bug Reports in Each Repository --\")\n",
    "    # a) Create a lookup dictioanry for language for faster access\n",
    "    repo_to_language_map = project_meta_df.set_index('repo_name')['language'].to_dict()\n",
    "\n",
    "    grouped_bugs = bug_reports_df.groupby('repo_name')\n",
    "\n",
    "    for repo_name, group in tqdm(grouped_bugs, desc='Verifying Repos'):\n",
    "        # Get metadata for the current repo\n",
    "        meta_row = project_meta_df[project_meta_df['repo_name'].str.lower() == repo_name]\n",
    "\n",
    "        # b) Print initial report for the current repo\n",
    "        print(f\"\\n--- Processing: {repo_name} -----\")\n",
    "        print(f\"(b) TOtal bug reports in file: {len(group)}\")\n",
    "        if not meta_row.empty:\n",
    "            print(f\"(b) total_unique_bug_reports from metadata: {meta_row['total_unique_bug_reports'].iloc[0]}\")\n",
    "        else:\n",
    "            print(\"(b) 'total_unique_bug_reports' from metadata: Not Found\")\n",
    "\n",
    "        language = repo_to_language_map.get(repo_name)\n",
    "\n",
    "        if not language:\n",
    "            tqdm.write(f\"Warning: Langauge not found for {repo_name} in metadata. Skipping...\")\n",
    "            continue\n",
    "\n",
    "        repo_path = os.path.join(clone_dir, language.lower(), repo_name.replace('/', '_'))\n",
    "\n",
    "        if not os.path.exists(repo_path):\n",
    "            tqdm.write(f\"Warning: Cloned repo not found for {repo_name}. All its bug reports will be removed\")\n",
    "            break\n",
    "\n",
    "        try: \n",
    "            repo = git.Repo(repo_path)\n",
    "            valid_commits_in_repo = 0\n",
    "\n",
    "            for index, bug_report in group.iterrows():\n",
    "                commit_sha = bug_report['pre_fix_commit_sha']\n",
    "\n",
    "                # Check if SHA is valid or empty\n",
    "                if pd.isna(commit_sha) or not commit_sha.strip():\n",
    "                    continue\n",
    "\n",
    "                # Verify commit exists in the repository\n",
    "                try:\n",
    "                    repo.commit(commit_sha)\n",
    "                    # If the above doesn't throw an error, the commit is valid\n",
    "                    valid_bug_indices.append(index)\n",
    "                    valid_commits_in_repo += 1\n",
    "                except (git.exc.BadName, git.exc.GitCommandError):\n",
    "                    # Commit does not exist, so we do nothing  (it won't be in the valid list)\n",
    "                    pass\n",
    "\n",
    "            print(f\"(b) Bug reports remaining after verification: {valid_commits_in_repo}\")\n",
    "        except Exception as e:\n",
    "            tqdm.write(f\"An unexpected error occurred while processing {repo_name}: {e}\")\n",
    "\n",
    "    # 4. Clean the bug reports Dataframe\n",
    "    cleaned_bug_reports_df = bug_reports_df.loc[valid_bug_indices.copy()]\n",
    "    print(f\"\\n-- Cleaning Complete --\")\n",
    "    print(f\" Original bug report count: {len(bug_reports_df)}\")\n",
    "    print(f\"Cleaned bug report count: {len(cleaned_bug_reports_df)}\")\n",
    "\n",
    "    # 5. Update the project metadata Dataframe\n",
    "    new_bug_counts = cleaned_bug_reports_df.groupby('repo_name')['bug_id'].count()\n",
    "\n",
    "    # Use .map() for a safe update that handles repos with 0 bugs left\n",
    "    project_meta_df['total_unique_bug_reports'] = project_meta_df['repo_name'].map(new_bug_counts).fillna(0).astype(int)\n",
    "\n",
    "    print(f\"\\n Update sum of 'total_unique_bug_reports' after cleaning: {project_meta_df['total_unique_bug_reports'].sum()}\")\n",
    "\n",
    "\n",
    "    # 6. Save the cleaned and updated files\n",
    "    cleaned_bug_reports_df.to_parquet(BUG_REPORTS_CLEAN_PATH, index=False)\n",
    "    project_meta_df.to_parquet(PROJECT_METADATA_PATH, index=False)\n",
    "    \n",
    "    print(f\"\\nSuccessfully saved cleaned data back to '{BUG_REPORTS_CLEAN_PATH}' and '{PROJECT_METADATA_PATH}'.\")"
   ]
  },
