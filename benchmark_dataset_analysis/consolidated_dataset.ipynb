    "def analyze_ground_truth_extensions(file_path):\n",
    "    '''\n",
    "    Reads the processed bug reports parquet file and analyzes the file extensions found in the 'ground_truth_files'\n",
    "    column, grouped by language.\n",
    "    '''\n",
    "    print(f\"Loading data from {file_path}...\")\n",
    "    try:\n",
    "        df_bugs = pd.read_parquet(file_path)\n",
    "    except FileNotFoundError:\n",
    "        print(f\"Error: The file was not found at '{file_path}'. \")\n",
    "        return\n",
    "    \n",
    "    # Use a defaultdict to easily collect extensions for each language\n",
    "    extensions_by_language = defaultdict(set)\n",
    "\n",
    "    print(\"Analyzing file extensions for each language....\")\n",
    "    # Iterate over each bug report in the DataFrame\n",
    "    for _, row in df_bugs.iterrows():\n",
    "        language = row.get('language').lower()\n",
    "        ground_truth_files = row.get('ground_truth_files')\n",
    "        # print(ground_truth_files)\n",
    "\n",
    "        # Skipp rows with missing language or ground truth files\n",
    "        # if not language or not isinstance(ground_truth_files, list):\n",
    "        #     continue\n",
    "        # print(\"I am here....\")\n",
    "        # Extract the extension from each file path\n",
    "        for filepath in ground_truth_files:\n",
    "            _, ext = os.path.splitext(filepath)\n",
    "\n",
    "            # Standardize the output for clarity\n",
    "            if ext:\n",
    "                extensions_by_language[language].add(ext.lower())\n",
    "    \n",
    "    # --- Print the Final Summary Report ---\n",
    "    print(\"\\n# --- Generated LANGUAGE_EXTENSIONS Dictionary ---\")\n",
    "    print(\"# Copy and paste this into your build_database_pipeline.py script\\n\")\n",
    "    print(\"LANGUAGE_EXTENSIONS = {\")\n",
    "\n",
    "    # Sort languages alphabetically for a consistent report\n",
    "    for language in sorted(extensions_by_language.keys()):\n",
    "        # Get the unique extensions and sort them alphabetically\n",
    "        sorted_extensions = sorted(list(extensions_by_language[language]))\n",
    "        \n",
    "        # Format the list of extensions into a string like \"'.ext1', '.ext2', ...\"\n",
    "        formatted_extensions = \", \".join([f\"'{ext}'\" for ext in sorted_extensions])\n",
    "        \n",
    "        # Print the final dictionary entry for this language\n",
    "        print(f\"    '{language}': [{formatted_extensions}],\")\n",
    "\n",
    "    print(\"}\")\n",
    "    print(\"# ------------------------------------------\")"
   ]
